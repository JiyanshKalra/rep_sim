# Every variable is optional; defaults are working defaults.

# Path to catalog file (default: backend/data/catalog.json, resolved from the source file)
CATALOG_PATH=backend/data/catalog.json

# Path to quotes storage file (default: backend/data/quotes.json, resolved from the source file)
QUOTES_PATH=backend/data/quotes.json

# Allowed CORS origins (default: http://localhost:3000,http://127.0.0.1:3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend API base URL (default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000
